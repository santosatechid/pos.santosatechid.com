generator client {
  provider   = "prisma-client"
  output     = "./generated"
  engineType = "client"
  runtime    = "bun"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String      @id @unique
  name          String
  email         String      @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  banExpires    DateTime?
  banReason     String?
  banned        Boolean?    @default(false)
  role          String?   @default("user")
  clientId      String?
  otpVerifiedAt DateTime?
  otpSentAt     DateTime?
  accounts      Account[]
  sessions      Session[]
  userData      UserData?
  membership    Membership?
  client        Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime
  updatedAt      DateTime
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
  issuer                String?
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@index([identifier])
  @@map("verification")
}

model UserData {
  id             String         @id @unique @default(cuid())
  userId         String?        @unique
  academicYearId String?
  address        String?
  avatarUrl      String?
  birthDate      DateTime?
  birthPlace     String?
  classId        String?
  employeeId     String?
  endDate        DateTime?
  enrollmentDate DateTime?
  gender         String?
  graduationDate DateTime?
  branchId       String?
  nik            String?
  nisn           String?
  parentPhone    String?
  position       String?
  relation       String?
  roleId         String?
  startDate      DateTime?
  status         String?        @default("active")
  studentIds     String[]
  email          String?
  name           String
  isActive       Boolean        @default(true)
  clientId       String?
  tahfidzGroupId String?
  createdAt      DateTime?      @default(now())
  updatedAt      DateTime?      @updatedAt
  Announcements  Announcement[]
  notifications  Notification[]
  branch         Branch?        @relation("UserBranch", fields: [branchId], references: [id])
  role           Role?          @relation(fields: [roleId], references: [id])
  user           User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  client         Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([academicYearId])
  @@index([classId])
  @@index([branchId])
  @@index([roleId])
  @@index([tahfidzGroupId])
  @@index([status])
  @@index([email])
  @@map("user_data")
}

model Role {
  id          String     @id @default(cuid())
  name        String
  description String
  clientId    String?
  permissions String[]
  isActive    Boolean    @default(true)
  userData    UserData[]
  client      Client?    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, name])
  @@index([clientId])
  @@map("roles")
}

model Branch {
  id           String     @id @default(cuid())
  name         String
  description  String?
  isActive     Boolean    @default(true)
  address      String?
  phone        String?
  adminName    String?
  signatureUrl String?
  clientId     String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  users        UserData[] @relation("UserBranch")
  tables       DiningTable[]
  orders       Order[]
  client       Client?    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("branches")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String
  category  String?
  isRead    Boolean   @default(false)
  link      String?
  data      Json?
  createdAt DateTime  @default(now())
  readAt    DateTime?
  user      UserData  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model Announcement {
  id          String    @id @default(cuid())
  title       String
  content     String
  imageUrl    String?
  linkUrl     String?
  startDate   DateTime?
  endDate     DateTime?
  userId      String?
  clientId    String
  isActive    Boolean   @default(true)
  isPublished Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        UserData? @relation(fields: [userId], references: [id], onDelete: Cascade)
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("announcements")
}

model Plan {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  description String?
  price       Int          @default(0)
  interval    String       @default("month")
  features    String[]
  isPopular   Boolean      @default(false)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]

  @@map("plans")
}

model Membership {
  id        String    @id @default(cuid())
  userId    String    @unique
  planId    String
  status    String    @default("active")
  startDate DateTime  @default(now())
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      Plan      @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([planId])
  @@index([status])
  @@map("memberships")
}

model Client {
  id               String            @id @default(cuid())
  name             String
  slug             String            @unique
  email            String?
  phone            String?
  address          String?
  logoUrl          String?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  users            User[]
  userData         UserData[]
  roles            Role[]
  branches         Branch[]
  announcements    Announcement[]
  qrisAccounts     QrisAccount[]
  qrisTransactions QrisTransaction[]
  products         Product[]
  diningTables     DiningTable[]
  orders           Order[]

  @@map("clients")
}

model QrisAccount {
  id            String            @id @default(cuid())
  clientId      String
  label         String
  staticPayload String            @db.Text
  merchantName  String
  merchantCity  String
  merchantNmid  String?
  webhookUrl    String?
  webhookSecret String
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  client        Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  transactions  QrisTransaction[]
  tables        DiningTable[]

  @@unique([clientId, label])
  @@index([clientId])
  @@map("qris_accounts")
}

model QrisTransaction {
  id             String            @id @default(cuid())
  clientId       String
  accountId      String
  orderId        String
  amount         Int
  dynamicPayload String            @db.Text
  status         String            @default("pending")
  expiresAt      DateTime
  paidAt         DateTime?
  confirmedBy    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  client         Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  account        QrisAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  deliveries     WebhookDelivery[]
  order          Order?            @relation("OrderPayment")

  @@unique([clientId, orderId])
  @@index([clientId, status])
  @@index([accountId])
  @@map("qris_transactions")
}

model WebhookDelivery {
  id            String          @id @default(cuid())
  transactionId String
  event         String
  url           String
  payload       Json
  statusCode    Int?
  attempts      Int             @default(0)
  ok            Boolean         @default(false)
  error         String?
  createdAt     DateTime        @default(now())
  deliveredAt   DateTime?
  transaction   QrisTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@map("qris_webhook_deliveries")
}

model Product {
  id          String      @id @default(cuid())
  clientId    String
  name        String
  description String?
  category    String?
  price       Int
  imageUrl    String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  client      Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]

  @@index([clientId])
  @@map("products")
}

model DiningTable {
  id            String       @id @default(cuid())
  clientId      String
  code          String
  label         String?
  token         String       @unique @default(cuid())
  qrisAccountId String?
  branchId      String?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  client        Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  qrisAccount   QrisAccount? @relation(fields: [qrisAccountId], references: [id], onDelete: SetNull)
  branch        Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  orders        Order[]

  @@unique([clientId, code])
  @@index([clientId])
  @@index([branchId])
  @@map("dining_tables")
}

model Order {
  id                String           @id @default(cuid())
  clientId          String
  tableId           String?
  branchId          String?
  customerName      String?
  note              String?
  status            String           @default("pending")
  orderType         String           @default("dine-in")
  paymentMethod     String           @default("qris")
  total             Int
  qrisTransactionId String?          @unique
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  client            Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  table             DiningTable?     @relation(fields: [tableId], references: [id], onDelete: SetNull)
  branch            Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  items             OrderItem[]
  qrisTransaction   QrisTransaction? @relation("OrderPayment", fields: [qrisTransactionId], references: [id], onDelete: SetNull)

  @@index([clientId, status])
  @@index([tableId])
  @@index([branchId])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String?
  productName String
  unitPrice   Int
  qty         Int
  note        String?
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}
